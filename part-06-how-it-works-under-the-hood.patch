new file mode 100644
--- /dev/null
+++ b/src/components/landing/underhood/highlight.js
@@ -0,0 +1,89 @@
+const KEYWORDS = new Set([
+  'const', 'let', 'var', 'function', 'return', 'await', 'async',
+  'import', 'from', 'export', 'new', 'if', 'else', 'for', 'while',
+  'class', 'extends', 'typeof', 'in', 'of', 'try', 'catch', 'finally',
+  'throw', 'default', 'true', 'false', 'null', 'undefined',
+]);
+
+const PUNCT = new Set([
+  '{', '}', '(', ')', '[', ']', ';', ',', '.', '=', ':', '<', '>',
+  '|', '&', '!', '+', '-', '*', '/', '?',
+]);
+
+export function tokenize(line) {
+  const tokens = [];
+  let i = 0;
+  while (i < line.length) {
+    const c = line[i];
+
+    if (c === '/' && line[i + 1] === '/') {
+      tokens.push({ text: line.slice(i), type: 'comment' });
+      break;
+    }
+
+    if (c === '"' || c === "'" || c === '`') {
+      const q = c;
+      let j = i + 1;
+      while (j < line.length && line[j] !== q) {
+        if (line[j] === '\\') j++;
+        j++;
+      }
+      j = Math.min(j + 1, line.length);
+      tokens.push({ text: line.slice(i, j), type: 'string' });
+      i = j;
+      continue;
+    }
+
+    if (/\d/.test(c)) {
+      let j = i;
+      while (j < line.length && /[\d_]/.test(line[j])) j++;
+      tokens.push({ text: line.slice(i, j), type: 'number' });
+      i = j;
+      continue;
+    }
+
+    if (/[a-zA-Z_$]/.test(c)) {
+      let j = i;
+      while (j < line.length && /[a-zA-Z0-9_$]/.test(line[j])) j++;
+      const word = line.slice(i, j);
+      tokens.push({
+        text: word,
+        type: KEYWORDS.has(word) ? 'keyword' : 'plain',
+      });
+      i = j;
+      continue;
+    }
+
+    if (/\s/.test(c)) {
+      let j = i;
+      while (j < line.length && /\s/.test(line[j])) j++;
+      tokens.push({ text: line.slice(i, j), type: 'plain' });
+      i = j;
+      continue;
+    }
+
+    tokens.push({ text: c, type: PUNCT.has(c) ? 'punct' : 'plain' });
+    i++;
+  }
+  return tokens;
+}
+
+export const TYPE_COLOR = {
+  keyword: 'text-[#C792EA]',
+  string: 'text-[#A5D6A7]',
+  number: 'text-[#F5A524]',
+  comment: 'text-ink-faint italic',
+  punct: 'text-ink-muted',
+  plain: 'text-ink',
+};
+
+export function clipTokens(tokens, budget) {
+  if (budget <= 0) return [];
+  const out = [];
+  let used = 0;
+  for (const t of tokens) {
+    if (used + t.text.length <= budget) {
+      out.push(t);
+      used += t.text.length;
+    } else {
+      const remaining = budget - used;
+      if (remaining > 0) out.push({ text: t.text.slice(0, remaining), type: t.type });
+      break;
+    }
+  }
+  return out;
+}
diff --git a/src/components/landing/underhood/CodePanel.jsx b/src/components/landing/underhood/CodePanel.jsx
new file mode 100644
--- /dev/null
+++ b/src/components/landing/underhood/CodePanel.jsx
@@ -0,0 +1,145 @@
+import { useMemo, useState, useEffect, useRef } from 'react';
+import { motion } from 'framer-motion';
+import { useInView, useReducedMotion } from 'framer-motion';
+import { tokenize, clipTokens, TYPE_COLOR } from './highlight';
+
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+
+export default function CodePanel({ title, language, code, delay = 0, status }) {
+  const ref = useRef(null);
+  const inView = useInView(ref, { margin: '-80px', once: false });
+  const reduced = useReducedMotion();
+  const [typed, setTyped] = useState(0);
+
+  const allTokens = useMemo(() => code.map(tokenize), [code]);
+  const totalChars = useMemo(
+    () => code.reduce((sum, line) => sum + line.length + 1, 0),
+    [code]
+  );
+
+  useEffect(() => {
+    if (!inView) {
+      setTyped(0);
+      return;
+    }
+    if (reduced) {
+      setTyped(totalChars);
+      return;
+    }
+
+    let cancelled = false;
+    const run = async () => {
+      await wait(delay);
+      while (!cancelled) {
+        setTyped(0);
+        await wait(300);
+        for (let i = 2; i <= totalChars; i += 2) {
+          if (cancelled) return;
+          setTyped(i);
+          await wait(20);
+        }
+        setTyped(totalChars);
+        await wait(3000);
+      }
+    };
+    run();
+    return () => {
+      cancelled = true;
+      setTyped(0);
+    };
+  }, [inView, reduced, delay, totalChars]);
+
+  let lineStart = 0;
+  const renderedLines = code.map((line, idx) => {
+    const budget = Math.max(0, Math.min(line.length, typed - lineStart));
+    const isActive = typed >= lineStart && typed <= lineStart + line.length;
+    const tokens = clipTokens(allTokens[idx], budget);
+    const lineEnd = lineStart + line.length + 1;
+    lineStart = lineEnd;
+    return { idx, line, tokens, isActive, isLast: false };
+  });
+  const lastVisibleIdx = renderedLines.reduce(
+    (last, l) => (l.tokens.length > 0 ? l.idx : last),
+    0
+  );
+
+  return (
+    <motion.div
+      ref={ref}
+      initial={{ opacity: 0, y: 20 }}
+      whileInView={{ opacity: 1, y: 0 }}
+      viewport={{ once: true, margin: '-80px' }}
+      transition={{ duration: 0.5, delay: delay / 1000, ease: [0.2, 0, 0, 1] }}
+      className="overflow-hidden rounded-xl border border-line bg-surface shadow-sm"
+    >
+      <div className="flex items-center gap-2 border-b border-line-subtle bg-raised/50 px-3 py-2">
+        <div className="flex gap-1.5">
+          <span className="h-2 w-2 rounded-full bg-red-500/50" />
+          <span className="h-2 w-2 rounded-full bg-amber-500/50" />
+          <span className="h-2 w-2 rounded-full bg-brand/50" />
+        </div>
+        <span className="ml-1 rounded-sm bg-surface px-1.5 py-0.5 font-mono text-[10px] text-ink-muted">
+          {title}
+        </span>
+        <span className="ml-auto font-mono text-[9px] uppercase tracking-wider text-ink-faint">
+          {language}
+        </span>
+      </div>
+
+      <div className="h-[320px] overflow-hidden bg-[#0A0A0C] px-3 py-2 font-mono text-[11px] leading-[20px]">
+        <div className="flex">
+          <div className="shrink-0 select-none pr-3 text-right text-[10px] text-ink-faint/60 tabular-nums">
+            {code.map((_, i) => (
+              <div key={i} className="leading-[20px]">
+                {i + 1}
+              </div>
+            ))}
+          </div>
+          <div className="min-w-0 flex-1 whitespace-pre">
+            {renderedLines.map((r) => (
+              <div key={r.idx} className="leading-[20px]">
+                {r.tokens.map((t, i) => (
+                  <span key={i} className={TYPE_COLOR[t.type]}>
+                    {t.text}
+                  </span>
+                ))}
+                {r.isActive && r.idx === lastVisibleIdx && !reduced && (
+                  <span className="ml-px inline-block h-[14px] w-[7px] animate-pulse bg-brand align-middle" />
+                )}
+                {r.tokens.length === 0 && !r.isActive && (
+                  <span className="text-ink-faint/0">&nbsp;</span>
+                )}
+              </div>
+            ))}
+          </div>
+        </div>
+      </div>
+
+      <div className="flex items-center gap-2 border-t border-line-subtle bg-raised/30 px-3 py-2">
+        <span className="relative flex h-1.5 w-1.5">
+          <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-60" />
+          <span className="relative inline-flex h-1.5 w-1.5 rounded-full bg-brand" />
+        </span>
+        <span className="truncate font-mono text-[10px] text-ink-muted">
+          {status}
+        </span>
+      </div>
+    </motion.div>
+  );
+}
