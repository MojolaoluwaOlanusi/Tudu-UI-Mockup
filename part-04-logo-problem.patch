@@ -0,0 +1,74 @@
+import { motion } from 'framer-motion';
+
+const STARTUPS = [
+  { name: 'Paystack', initial: 'P' },
+  { name: 'Flutterwave', initial: 'F' },
+  { name: 'Kuda', initial: 'K' },
+  { name: 'Piggyvest', initial: 'P' },
+  { name: 'Andela', initial: 'A' },
+  { name: 'Mono', initial: 'M' },
+  { name: 'Termii', initial: 'T' },
+  { name: 'Cowrywise', initial: 'C' },
+];
+
+function Logo({ name, initial }) {
+  return (
+    <div className="group flex shrink-0 items-center gap-2.5 opacity-55 transition-opacity duration-300 hover:opacity-100">
+      <span className="flex h-7 w-7 items-center justify-center rounded-md border border-line bg-raised text-[11px] font-semibold text-brand">
+        {initial}
+      </span>
+      <span className="whitespace-nowrap text-[15px] font-medium tracking-tight text-ink-muted transition-colors group-hover:text-ink">
+        {name}
+      </span>
+    </div>
+  );
+}
+
+export default function LogoStrip() {
+  return (
+    <section className="relative border-y border-line-subtle bg-canvas py-10 lg:py-12">
+      <div className="mx-auto max-w-7xl px-6">
+        <p className="mb-8 text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-faint">
+          Trusted by builders who{' '}
+          <span className="text-brand">outgrew Trello</span>
+        </p>
+
+        <div
+          className="relative overflow-hidden"
+          style={{
+            maskImage:
+              'linear-gradient(to right, transparent, black 8%, black 92%, transparent)',
+            WebkitMaskImage:
+              'linear-gradient(to right, transparent, black 8%, black 92%, transparent)',
+          }}
+        >
+          <motion.div
+            className="flex w-max"
+            animate={{ x: ['0%', '-50%'] }}
+            transition={{ duration: 42, repeat: Infinity, ease: 'linear' }}
+          >
+            <div className="flex gap-14 pr-14">
+              {STARTUPS.map((s) => (
+                <Logo key={s.name} {...s} />
+              ))}
+            </div>
+            <div className="flex gap-14 pr-14" aria-hidden="true">
+              {STARTUPS.map((s) => (
+                <Logo key={s.name + '-dup'} {...s} />
+              ))}
+            </div>
+          </motion.div>
+        </div>
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/landing/ProblemSection.jsx b/src/components/landing/ProblemSection.jsx
new file mode 100644
--- /dev/null
+++ b/src/components/landing/ProblemSection.jsx
@@ -0,0 +1,236 @@
+import { useState } from 'react';
+import { motion, AnimatePresence } from 'framer-motion';
+import { Check, X } from 'lucide-react';
+
+const CARDS = {
+  trello: {
+    name: 'Trello',
+    tagline: "Great, until it isn't.",
+    bullets: [
+      'No real filters',
+      'Breaks on mobile',
+      'Power-ups cost more than your rent',
+    ],
+    impact: 'Teams spend $1k+/mo on workarounds Tudu gives free.',
+    tone: 'competitor',
+  },
+  tudu: {
+    name: 'Tudu',
+    tagline: 'The middle path.',
+    bullets: [
+      'Fast like Trello',
+      'Powerful where it counts',
+      'Free for personal use',
+      'Offline-first',
+    ],
+    impact: 'The only board your whole team actually opens.',
+    tone: 'brand',
+  },
+  jira: {
+    name: 'Jira',
+    tagline: 'Powerful, until it slows you down.',
+    bullets: [
+      '10 clicks to create a task',
+      'You need a course to use it',
+      'Config debt you can’t undo',
+    ],
+    impact: 'Teams burn the first sprint just onboarding.',
+    tone: 'competitor',
+  },
+};
+
+function Card({ cardKey, card, mode, index }) {
+  const [hovered, setHovered] = useState(false);
+  const isDimmed =
+    (cardKey === 'trello' && mode === 'jira') ||
+    (cardKey === 'jira' && mode === 'trello');
+  const isTudu = cardKey === 'tudu';
+
+  return (
+    <motion.div
+      initial={{ opacity: 0, y: 24 }}
+      whileInView={{ opacity: 1, y: 0 }}
+      viewport={{ once: true, margin: '-80px' }}
+      transition={{ duration: 0.5, delay: index * 0.08 }}
+    >
+      <motion.div
+        animate={{
+          opacity: isDimmed ? 0.35 : 1,
+          scale: isDimmed ? 0.98 : 1,
+        }}
+        transition={{ duration: 0.3, ease: [0.2, 0, 0, 1] }}
+        onMouseEnter={() => setHovered(true)}
+        onMouseLeave={() => setHovered(false)}
+        className={`relative h-full rounded-lg border p-5 ${
+          isTudu
+            ? 'border-brand/40 bg-brand-subtle'
+            : 'border-line bg-surface'
+        }`}
+      >
+        <div className="flex items-start justify-between gap-2">
+          <div className="min-w-0">
+            <div className="flex items-center gap-2">
+              <span
+                className={`h-2 w-2 shrink-0 rounded-full ${
+                  isTudu ? 'bg-brand' : 'bg-ink-faint'
+                }`}
+              />
+              <span className="text-[11px] font-semibold uppercase tracking-wider text-ink-muted">
+                {card.name}
+              </span>
+            </div>
+            <p
+              className={`mt-2 text-sm leading-snug ${
+                isTudu ? 'text-ink' : 'text-ink-muted'
+              }`}
+            >
+              {card.tagline}
+            </p>
+          </div>
+          {isTudu && (
+            <span className="shrink-0 rounded-sm bg-brand/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand">
+              You're here
+            </span>
+          )}
+        </div>
+
+        <div className="my-4 h-px bg-line-subtle" />
+
+        <ul className="space-y-2">
+          {card.bullets.map((bullet, i) => (
+            <motion.li
+              key={bullet}
+              initial={{ opacity: 0, x: -4 }}
+              whileInView={{ opacity: 1, x: 0 }}
+              viewport={{ once: true }}
+              transition={{ duration: 0.3, delay: index * 0.08 + 0.2 + i * 0.05 }}
+              className="flex items-start gap-2 text-[13px]"
+            >
+              {isTudu ? (
+                <Check
+                  className="mt-0.5 h-3.5 w-3.5 shrink-0 text-brand"
+                  strokeWidth={2.5}
+                />
+              ) : (
+                <X
+                  className="mt-0.5 h-3.5 w-3.5 shrink-0 text-red-400/80"
+                  strokeWidth={2.5}
+                />
+              )}
+              <span className={isTudu ? 'text-ink' : 'text-ink-muted'}>
+                {bullet}
+              </span>
+            </motion.li>
+          ))}
+        </ul>
+
+        <AnimatePresence initial={false}>
+          {hovered && (
+            <motion.div
+              initial={{ opacity: 0, height: 0 }}
+              animate={{ opacity: 1, height: 'auto' }}
+              exit={{ opacity: 0, height: 0 }}
+              transition={{ duration: 0.22, ease: [0.2, 0, 0, 1] }}
+              className="overflow-hidden"
+            >
+              <div
+                className={`mt-3 rounded-md border-l-2 px-3 py-2 text-[11px] leading-relaxed ${
+                  isTudu
+                    ? 'border-brand bg-brand-subtle/60 text-ink'
+                    : 'border-red-400/50 bg-red-500/5 text-ink-muted'
+                }`}
+              >
+                <span className="font-semibold">{isTudu ? '→ ' : '⚠ '}</span>
+                {card.impact}
+              </div>
+            </motion.div>
+          )}
+        </AnimatePresence>
+      </motion.div>
+    </motion.div>
+  );
+}
+
+export default function ProblemSection() {
+  const [mode, setMode] = useState('trello');
+
+  return (
+    <section className="mx-auto max-w-7xl px-6 py-20 lg:py-28">
+      <div className="mb-10 max-w-2xl">
+        <p className="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-faint">
+          The honest comparison
+        </p>
+        <h2 className="text-balance text-3xl font-semibold leading-tight text-ink sm:text-4xl">
+          You've outgrown the options. There's a middle path.
+        </h2>
+        <p className="mt-3 text-base leading-relaxed text-ink-muted">
+          Trello is fast but shallow. Jira is deep but slow. Tudu is both fast and
+          deep — because we're not trying to be either.
+        </p>
+      </div>
+
+      <div className="mb-8 inline-flex rounded-lg border border-line bg-surface p-1">
+        {[
+          { key: 'trello', label: 'Trello vs Tudu' },
+          { key: 'jira', label: 'Jira vs Tudu' },
+        ].map((opt) => (
+          <button
+            key={opt.key}
+            type="button"
+            onClick={() => setMode(opt.key)}
+            className="relative rounded-md px-4 py-1.5 text-[13px] font-medium transition-colors"
+            aria-pressed={mode === opt.key}
+          >
+            {mode === opt.key && (
+              <motion.div
+                layoutId="problem-toggle"
+                className="absolute inset-0 rounded-md bg-raised"
+                transition={{ type: 'spring', stiffness: 380, damping: 30 }}
+              />
+            )}
+            <span
+              className={`relative z-10 ${
+                mode === opt.key ? 'text-ink' : 'text-ink-muted'
+              }`}
+            >
+              {opt.label}
+            </span>
+          </button>
+        ))}
+      </div>
+
+      <div className="grid grid-cols-1 gap-4 lg:grid-cols-3">
+        <Card cardKey="trello" card={CARDS.trello} mode={mode} index={0} />
+        <Card cardKey="tudu" card={CARDS.tudu} mode={mode} index={1} />
+        <Card cardKey="jira" card={CARDS.jira} mode={mode} index={2} />
+      </div>
+    </section>
+  );
+}
