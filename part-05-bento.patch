+import { useState, useEffect } from 'react';
+import { motion, AnimatePresence } from 'framer-motion';
+import { Undo2, WifiOff, CheckCircle2, Palette, Users, Terminal, Layers, Shield } from 'lucide-react';
+import { TileHeader, useTileInView, wait } from './shared';
+import { cn } from '@/lib/utils';
+
+/* ------------------------------------------------------------------ */
+/* 4. Never lose work — delete → undo → offline → synced               */
+/* ------------------------------------------------------------------ */
+
+export function NeverLoseWorkTile({ className }) {
+  const { ref, inView } = useTileInView();
+  const [step, setStep] = useState(0); // 0 delete, 1 toast, 2 offline, 3 syncing, 4 synced
+
+  useEffect(() => {
+    if (!inView) return;
+    let cancelled = false;
+    const run = async () => {
+      while (!cancelled) {
+        setStep(0); await wait(700); if (cancelled) return;
+        setStep(1); await wait(1600); if (cancelled) return;
+        setStep(2); await wait(1200); if (cancelled) return;
+        setStep(3); await wait(1400); if (cancelled) return;
+        setStep(4); await wait(2000);
+      }
+    };
+    run();
+    return () => { cancelled = true; };
+  }, [inView]);
+
+  return (
+    <motion.div
+      ref={ref}
+      initial={{ opacity: 0, y: 20 }}
+      whileInView={{ opacity: 1, y: 0 }}
+      whileHover={{ y: -2, transition: { duration: 0.15 } }}
+      viewport={{ once: true, margin: '-80px' }}
+      transition={{ duration: 0.4, ease: [0.2, 0, 0, 1] }}
+      className={cn('relative overflow-hidden rounded-xl border border-line bg-surface p-5 transition-colors duration-300 hover:border-line-strong', className)}
+    >
+      <TileHeader title="Never lose work" icon={<Undo2 className="h-3.5 w-3.5" />} />
+
+      <div className="mt-4 min-h-[180px]">
+        <AnimatePresence mode="wait">
+          {step <= 1 && (
+            <motion.div key="task" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0, x: -8 }}>
+              <div className={cn('rounded-md border border-line bg-raised px-2.5 py-2 transition-all', step === 1 && 'opacity-40 line-through')}>
+                <p className="text-[12px] text-ink">Delete Q4 board</p>
+              </div>
+            </motion.div>
+          )}
+        </AnimatePresence>
+
+        <AnimatePresence>
+          {step >= 1 && step <= 2 && (
+            <motion.div
+              key="toast"
+              initial={{ opacity: 0, y: 8 }}
+              animate={{ opacity: 1, y: 0 }}
+              exit={{ opacity: 0, y: 8 }}
+              className="mt-3 flex items-center gap-2 rounded-md border border-line bg-surface px-2.5 py-2 shadow-lg"
+            >
+              <Undo2 className="h-3 w-3 shrink-0 text-brand" />
+              <span className="min-w-0 flex-1 truncate text-[11px] text-ink">Deleted "Q4 board"</span>
+              <span className="shrink-0 rounded-sm bg-brand px-1.5 py-0.5 text-[10px] font-semibold text-ink-inverse">Undo</span>
+            </motion.div>
+          )}
+        </AnimatePresence>
+
+        <AnimatePresence>
+          {step >= 2 && (
+            <motion.div
+              key="status"
+              initial={{ opacity: 0, y: 8 }}
+              animate={{ opacity: 1, y: 0 }}
+              className="mt-3 flex items-center gap-2 rounded-md border border-line bg-raised px-2.5 py-2"
+            >
+              {step === 2 && (
+                <>
+                  <WifiOff className="h-3 w-3 shrink-0 text-amber-400" />
+                  <span className="text-[11px] text-ink-muted">Offline — 1 change queued</span>
+                </>
+              )}
+              {step === 3 && (
+                <>
+                  <motion.span
+                    className="h-3 w-3 shrink-0 rounded-full border-2 border-brand border-t-transparent"
+                    animate={{ rotate: 360 }}
+                    transition={{ duration: 0.8, repeat: Infinity, ease: 'linear' }}
+                  />
+                  <span className="text-[11px] text-ink-muted">Syncing…</span>
+                </>
+              )}
+              {step === 4 && (
+                <>
+                  <CheckCircle2 className="h-3 w-3 shrink-0 text-brand" />
+                  <span className="text-[11px] font-medium text-ink">Synced — deleted task restored</span>
+                </>
+              )}
+            </motion.div>
+          )}
+        </AnimatePresence>
+      </div>
+
+      <p className="mt-3 border-t border-line-subtle pt-3 text-[10px] text-ink-faint">
+        Soft delete + offline queue + auto-sync
+      </p>
+    </motion.div>
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* 5. Boards that fit — color swatches, WIP badge, template chips      */
+/* ------------------------------------------------------------------ */
+
+const COLORS = ['#8B5CF6', '#F5A524', '#22C55E', '#EF4444', '#3B82F6'];
+const TEMPLATES = ['Sprint', 'Bug Fix', 'Content'];
+
+export function BoardsThatFitTile({ className }) {
+  const { ref, inView } = useTileInView();
+  const [active, setActive] = useState(0);
+  const [installing, setInstalling] = useState(null);
