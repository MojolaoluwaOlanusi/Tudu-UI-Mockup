+      className={cn('relative overflow-hidden rounded-xl border border-line bg-surface p-5 transition-colors duration-300 hover:border-line-strong', className)}
+    >
+      <TileHeader title="Integrations" icon={<Github className="h-3.5 w-3.5" />} />
+
+      <div className="mt-4 space-y-1.5">
+        {[
+          { name: 'GitHub', icon: <Github className="h-3 w-3" /> },
+          { name: 'Slack', icon: <span className="text-[10px] font-bold">#</span> },
+        ].map((item, i) => (
+          <motion.div
+            key={item.name}
+            animate={{ opacity: revealed > i ? 1 : 0.3 }}
+            className="flex items-center gap-2 rounded-md border border-line-subtle bg-raised px-2 py-1.5"
+          >
+            <span className="flex h-4 w-4 items-center justify-center rounded-sm bg-line-subtle text-ink-muted">
+              {item.icon}
+            </span>
+            <span className="min-w-0 flex-1 text-[11px] text-ink">{item.name}</span>
+            {revealed > i && (
+              <motion.span
+                initial={{ scale: 0.4, opacity: 0 }}
+                animate={{ scale: 1, opacity: 1 }}
+                className="text-[10px] text-brand"
+              >
+                ✓
+              </motion.span>
+            )}
+          </motion.div>
+        ))}
+      </div>
+    </motion.div>
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* 14. Analytics — animated bar chart                                  */
+/* ------------------------------------------------------------------ */
+
+const BAR_VALS = [40, 65, 48, 78, 90, 72, 85];
+
+export function AnalyticsTile({ className }) {
+  const { ref, inView } = useTileInView();
+  const [progress, setProgress] = useState(0);
+
+  useEffect(() => {
+    if (!inView) return;
+    const t0 = Date.now();
+    const duration = 1600;
+    let raf;
+    const step = () => {
+      const p = Math.min(1, (Date.now() - t0) / duration);
+      setProgress(p);
+      if (p < 1) raf = requestAnimationFrame(step);
+    };
+    raf = requestAnimationFrame(step);
+    return () => cancelAnimationFrame(raf);
+  }, [inView]);
+
+  return (
+    <motion.div
+      ref={ref}
+      initial={{ opacity: 0, y: 20 }}
+      whileInView={{ opacity: 1, y: 0 }}
+      whileHover={{ y: -2, transition: { duration: 0.15 } }}
+      viewport={{ once: true, margin: '-80px' }}
+      transition={{ duration: 0.4, ease: [0.2, 0, 0, 1] }}
+      className={cn('relative overflow-hidden rounded-xl border border-line bg-surface p-5 transition-colors duration-300 hover:border-line-strong', className)}
+    >
+      <TileHeader title="Analytics that ship" icon={<BarChart3 className="h-3.5 w-3.5" />} />
+
+      <div className="mt-4 flex h-16 items-end gap-1.5">
+        {BAR_VALS.map((v, i) => (
+          <div key={i} className="flex-1">
+            <motion.div
+              animate={{ height: `${v * progress}%` }}
+              transition={{ duration: 0.1 }}
+              className="rounded-t-sm bg-brand"
+              style={{ height: 0 }}
+            />
+          </div>
+        ))}
+      </div>
+      <div className="mt-3 flex items-center justify-between text-[10px]">
+        <span className="text-ink-faint">Completion</span>
+        <span className="font-semibold text-brand">{Math.round(67 * progress)}%</span>
+      </div>
+    </motion.div>
+  );
+}
