diff --git a/src/styles/brand.css b/src/styles/brand.css
new file mode 100644
--- /dev/null
+++ b/src/styles/brand.css
@@ -0,0 +1,32 @@
+/* Brand utilities — brush stroke on primary CTAs, glass on the sticky navbar */
+
+.brush-stroke {
+  position: relative;
+}
+
+.brush-stroke::before {
+  content: '';
+  position: absolute;
+  left: 10%;
+  right: 10%;
+  bottom: -4px;
+  height: 4px;
+  background: linear-gradient(90deg, transparent, var(--accent), transparent);
+  border-radius: 999px;
+  opacity: 0.55;
+  pointer-events: none;
+  transition: opacity 180ms cubic-bezier(0.2, 0, 0, 1);
+}
+
+.brush-stroke:hover::before {
+  opacity: 1;
+}
+
+.glass {
+  background-color: color-mix(in srgb, var(--bg-surface) 65%, transparent);
+  backdrop-filter: blur(20px) saturate(180%);
+  -webkit-backdrop-filter: blur(20px) saturate(180%);
+  border-bottom: 1px solid var(--border-subtle);
+}
