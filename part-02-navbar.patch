+    lg: { text: 'text-5xl', check: 'h-6 w-6', gap: 'gap-2' },
+  };
+  const s = sizes[size] || sizes.md;
+  return (
+    <span className={`inline-flex items-baseline ${s.gap}`} aria-label="Tudu">
+      <span className={`font-brand ${s.text} leading-none text-ink`}>tudu</span>
